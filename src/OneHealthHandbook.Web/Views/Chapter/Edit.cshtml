@model OneHealthHandbook.Web.ViewModels.ChapterEditViewModel
@using System.Collections.Generic
@using System.Web.Mvc
@{
    ViewBag.Title = "Edit Chapter";
    var reviewerOptions = ViewBag.ReviewerOptions as IList<SelectListItem> ?? new List<SelectListItem>();
}

<section class="mx-auto max-w-[1400px] px-4 lg:px-6">
    <div class="mx-auto max-w-[1260px] rounded-lg bg-white p-8 shadow">
    <h2 class="mb-4 text-2xl font-bold">Edit Chapter Draft</h2>
    <p class="mb-3 text-sm text-slate-600">Content ID: @Model.ContentNumber | Chapter ID: @(Model.ChapterNumber.HasValue ? Model.ChapterNumber.Value.ToString() : "New")</p>

    <div class="mb-5 rounded border border-slate-200 bg-slate-50 p-4">
        <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-600">Current Chapter Content</h3>
            <button id="toggleCurrentChapterContent" type="button" class="inline-flex items-center gap-2 rounded border border-slate-300 bg-white px-3 py-1 text-xs font-medium text-slate-700" aria-expanded="false" aria-label="Expand current chapter content">
                <span id="toggleCurrentChapterContentIcon" class="inline-flex h-4 w-4 items-center justify-center rounded border border-slate-300 text-[10px] leading-none">+</span>
                <span id="toggleCurrentChapterContentText">Expand</span>
            </button>
        </div>
        <div id="currentChapterContentPanel" class="mt-3 hidden prose prose-slate max-w-none text-slate-700 prose-headings:font-semibold prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-p:leading-7">@Html.Raw(Model.ChapterBody)</div>
    </div>

    @using (Html.BeginForm("Edit", "Chapter", FormMethod.Post, new { id = "chapterForm", @class = "space-y-4" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ChapterId)
        @Html.HiddenFor(m => m.ContentId)
        @Html.HiddenFor(m => m.ReviewerIds, new { id = "reviewerIds" })
        @Html.ValidationSummary(true, "", new { @class = "text-sm text-red-600" })

        <div>
            @Html.LabelFor(m => m.ChapterTitle, new { @class = "mb-1 block text-sm font-medium" })
            @Html.TextBoxFor(m => m.ChapterTitle, new
            {
                @class = "w-full rounded-md border border-slate-300 px-3 py-2",
                maxlength = "250"
            })
            @Html.ValidationMessageFor(m => m.ChapterTitle, "", new { @class = "text-xs text-red-600" })
        </div>

        <div>
            @Html.LabelFor(m => m.ChapterBody, new { @class = "mb-1 block text-sm font-medium" })
            @Html.TextAreaFor(m => m.ChapterBody, 14, 60, new { @class = "hidden", id = "chapterBodyEditor" })
            <div id="chapterBodyEditorContainer" class="rounded-md border border-slate-300 bg-white"></div>
            @Html.ValidationMessageFor(m => m.ChapterBody, "", new { @class = "text-xs text-red-600" })
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium">Assign Reviewer(s)</label>
            <select id="reviewerSelect" class="w-full" multiple>
                @foreach (var option in reviewerOptions)
                {
                    <option value="@option.Value" @(option.Selected ? "selected" : null)>@option.Text</option>
                }
            </select>
            <p class="mt-1 text-xs text-slate-500">Select at least one reviewer from this dropdown. Plain text entry is not allowed.</p>
        </div>

        <div>
            @Html.LabelFor(m => m.ChangeNotes, "Change Notes For Reviewers", new { @class = "mb-1 block text-sm font-medium" })
            @Html.TextAreaFor(m => m.ChangeNotes, 4, 60, new { @class = "w-full rounded-md border border-slate-300 px-3 py-2", placeholder = "Describe what changed and what reviewers should focus on." })
            @Html.ValidationMessageFor(m => m.ChangeNotes, "", new { @class = "text-xs text-red-600" })
        </div>

        <button type="submit" class="rounded bg-slate-900 px-4 py-2 text-white">Save Draft</button>
    }
    </div>
</section>

@section scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        #chapterBodyEditorContainer .ql-editor { min-height: 420px; font-family: Georgia, 'Times New Roman', serif; font-size: 17px; line-height: 1.65; }
        #chapterBodyEditorContainer .ql-editor h1 { font-size: 2.1rem; }
        #chapterBodyEditorContainer .ql-editor h2 { font-size: 1.7rem; }
        #chapterBodyEditorContainer .ql-editor h3 { font-size: 1.35rem; }
    </style>
    <script>
        $(function () {
            var $currentContentPanel = $("#currentChapterContentPanel");
            var $toggleCurrentContent = $("#toggleCurrentChapterContent");
            var $toggleCurrentContentIcon = $("#toggleCurrentChapterContentIcon");
            var $toggleCurrentContentText = $("#toggleCurrentChapterContentText");

            function setCurrentContentToggle(isExpanded) {
                if (isExpanded) {
                    $toggleCurrentContentText.text("Collapse");
                    $toggleCurrentContentIcon.text("-");
                    $toggleCurrentContent.attr("aria-expanded", "true");
                    $toggleCurrentContent.attr("aria-label", "Collapse current chapter content");
                } else {
                    $toggleCurrentContentText.text("Expand");
                    $toggleCurrentContentIcon.text("+");
                    $toggleCurrentContent.attr("aria-expanded", "false");
                    $toggleCurrentContent.attr("aria-label", "Expand current chapter content");
                }
            }

            $toggleCurrentContent.on("click", function () {
                var isHidden = $currentContentPanel.hasClass("hidden");
                if (isHidden) {
                    $currentContentPanel.removeClass("hidden");
                    setCurrentContentToggle(true);
                } else {
                    $currentContentPanel.addClass("hidden");
                    setCurrentContentToggle(false);
                }
            });

            setCurrentContentToggle(false);

            $("#reviewerSelect").select2({
                width: "100%",
                placeholder: "Select reviewer(s)",
                closeOnSelect: false
            });

            var chapterBodyQuill = new Quill("#chapterBodyEditorContainer", {
                theme: "snow",
                modules: {
                    toolbar: {
                        container: [
                            [{ header: [1, 2, 3, false] }],
                            ["bold", "italic", "underline", "strike"],
                            [{ color: [] }, { background: [] }],
                            [{ align: [] }],
                            [{ list: "ordered" }, { list: "bullet" }],
                            [{ indent: "-1" }, { indent: "+1" }],
                            ["blockquote", "code-block"],
                            ["link", "image"],
                            ["clean"]
                        ],
                        handlers: {
                            image: function () {
                                var url = window.prompt("Enter image URL");
                                if (url) {
                                    var range = this.quill.getSelection(true);
                                    this.quill.insertEmbed(range.index, "image", url, "user");
                                    this.quill.setSelection(range.index + 1);
                                }
                            }
                        }
                    }
                }
            });
            chapterBodyQuill.clipboard.dangerouslyPasteHTML($("#chapterBodyEditor").val());

            function getChapterBodyHtml() {
                var html = chapterBodyQuill.root.innerHTML;
                return html === "<p><br></p>" ? "" : html;
            }

            $("#chapterForm").on("submit", function () {
                $("#chapterBodyEditor").val(getChapterBodyHtml());

                var selectedReviewerIds = $("#reviewerSelect").val() || [];
                if (selectedReviewerIds.length < 1) {
                    alert("Please select at least one reviewer before saving the draft.");
                    return false;
                }

                $("#reviewerIds").val(selectedReviewerIds.join(","));
            });

            $("#chapterForm").validate({
                ignore: [],
                rules: {
                    ChapterTitle: { required: true, maxlength: 250 },
                    ChapterBody: { required: true }
                }
            });
        });
    </script>
}

