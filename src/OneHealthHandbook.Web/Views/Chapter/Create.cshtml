@model OneHealthHandbook.Web.ViewModels.ChapterEditViewModel
@{
    ViewBag.Title = "Add Chapter";
}

<section class="mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-[860px] rounded-lg bg-white p-8 shadow">
    <h2 class="mb-4 text-2xl font-bold">Add Chapter</h2>

    @using (Html.BeginForm("Create", "Chapter", FormMethod.Post, new { id = "chapterForm", @class = "space-y-4" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ContentId)
        @Html.ValidationSummary(true, "", new { @class = "text-sm text-red-600" })

        <div>
            @Html.LabelFor(m => m.ChapterTitle, new { @class = "mb-1 block text-sm font-medium" })
            @Html.TextBoxFor(m => m.ChapterTitle, new
            {
                @class = "w-full rounded-md border border-slate-300 px-3 py-2",
                maxlength = "250"
            })
            @Html.ValidationMessageFor(m => m.ChapterTitle, "", new { @class = "text-xs text-red-600" })
        </div>

        <div>
            @Html.LabelFor(m => m.ChapterBody, new { @class = "mb-1 block text-sm font-medium" })
            @Html.TextAreaFor(m => m.ChapterBody, 14, 60, new { @class = "hidden", id = "chapterBodyEditor" })
            <div id="chapterBodyEditorContainer" class="rounded-md border border-slate-300 bg-white"></div>
            @Html.ValidationMessageFor(m => m.ChapterBody, "", new { @class = "text-xs text-red-600" })
            <p class="mt-1 text-xs text-slate-500">Use rich formatting tools for headings, alignment, lists, and
                links.</p>
            </div>

            <button type="submit" class="rounded bg-slate-900 px-4 py-2 text-white">Save Chapter</button>
        }
    </div>
</section>

    @section scripts {
        <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.min.js"></script>
        <style>
            #chapterBodyEditorContainer .ql-editor { min-height: 420px; font-family: Georgia, 'Times New Roman', serif; font-size: 16px; line-height: 1.6; }
            #chapterBodyEditorContainer .ql-editor h1 { font-size: 2rem; }
            #chapterBodyEditorContainer .ql-editor h2 { font-size: 1.6rem; }
            #chapterBodyEditorContainer .ql-editor h3 { font-size: 1.3rem; }
        </style>
        <script>
            $(function () {
                var chapterBodyQuill = new Quill("#chapterBodyEditorContainer", {
                    theme: "snow",
                    modules: {
                        toolbar: {
                            container: [
                                [{ header: [1, 2, 3, false] }],
                                ["bold", "italic", "underline", "strike"],
                                [{ color: [] }, { background: [] }],
                                [{ align: [] }],
                                [{ list: "ordered" }, { list: "bullet" }],
                                [{ indent: "-1" }, { indent: "+1" }],
                                ["blockquote", "code-block"],
                                ["link", "image"],
                                ["clean"]
                            ],
                            handlers: {
                                image: function () {
                                    var url = window.prompt("Enter image URL");
                                    if (url) {
                                        var range = this.quill.getSelection(true);
                                        this.quill.insertEmbed(range.index, "image", url, "user");
                                        this.quill.setSelection(range.index + 1);
                                    }
                                }
                            }
                        }
                    }
                });
                chapterBodyQuill.clipboard.dangerouslyPasteHTML($("#chapterBodyEditor").val());

                function getChapterBodyHtml() {
                    var html = chapterBodyQuill.root.innerHTML;
                    return html === "<p><br></p>" ? "" : html;
                }

                $("#chapterForm").on("submit", function () {
                    $("#chapterBodyEditor").val(getChapterBodyHtml());
                });

                $("#chapterForm").validate({
                    ignore: [],
                    rules: {
                        ChapterTitle: { required: true, maxlength: 250 },
                        ChapterBody: { required: true }
                    },
                    messages: {
                        ChapterTitle: "Chapter title is required.",
                        ChapterBody: "Chapter body is required."
                    }
                });
            });
        </script>
    }

