<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Content Publishing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --space-1: 8px;
            --space-2: 16px;
            --space-3: 24px;
            --space-4: 32px;
            --space-5: 40px;
            --space-6: 48px;
            --radius-sm: 8px;
            --radius-md: 16px;
            --radius-lg: 24px;
            --app-bg: #eef9f3;
            --surface: #ffffff;
            --surface-2: #e3f3e8;
            --ink-1: #101828;
            --ink-2: #2d3a54;
            --ink-3: #4f5f80;
            --line: #bfdcc8;
            --accent: #15803d;
            --accent-strong: #166534;
            --accent-contrast: #ffffff;
            --header-bg: #0f3b24;
            --header-highlight: #22a060;
            --label-color: #14532d;
            --danger: #b42318;
            --warning: #b54708;
            --success: #067647;
            --focus-ring: #86efac;
        }

        body {
            color: var(--ink-1);
            font-family: "Manrope", sans-serif;
            background-color: var(--app-bg);
            background-image:
                radial-gradient(circle at 90% 8%, rgba(21, 128, 61, 0.14) 0 18%, transparent 18%),
                radial-gradient(circle at 12% 86%, rgba(22, 101, 52, 0.13) 0 14%, transparent 14%),
                linear-gradient(180deg, #f7fdf9 0%, var(--app-bg) 52%, #dff1e6 100%);
            min-height: 100vh;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: 0.2;
            background-image: radial-gradient(rgba(16, 24, 40, 0.08) 0.4px, transparent 0.4px);
            background-size: 4px 4px;
            z-index: -1;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: "Space Grotesk", sans-serif;
            letter-spacing: 0.01em;
            color: var(--ink-1);
        }

        .app-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius-md);
            box-shadow: 0 12px 30px rgba(15, 59, 36, 0.08);
        }

        .app-topbar {
            position: relative;
            background: var(--header-bg);
            border-bottom: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 14px 32px rgba(8, 44, 25, 0.35);
        }

        .app-topbar::after {
            content: "";
            position: absolute;
            left: -10%;
            right: 35%;
            bottom: -1px;
            height: 3px;
            background: var(--header-highlight);
            transform: skewX(-25deg);
        }

        .app-topbar h1 {
            color: #fbfdff;
        }

        .app-topbar p {
            color: #d6f5e2;
        }

        .app-topbar .app-nav-link {
            color: #f3f8ff;
        }

        .app-topbar .app-nav-link:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        label,
        .app-label {
            color: var(--label-color);
            font-weight: 700;
            letter-spacing: 0.01em;
        }

        input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]),
        select,
        textarea,
        .app-form-field {
            width: 100%;
            border: 1px solid var(--line);
            background: #ffffff;
            color: var(--ink-1);
            border-radius: var(--radius-sm);
            padding: 0 var(--space-2);
            box-shadow: inset 0 1px 0 rgba(16, 24, 40, 0.03);
        }

        textarea {
            min-height: 120px;
            padding-top: 10px;
            padding-bottom: 10px;
        }

        input::placeholder,
        textarea::placeholder {
            color: #6b7a99;
        }

        table.min-w-full {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
            overflow: hidden;
            border-radius: var(--radius-md);
            border: 1px solid var(--line);
            background: #ffffff;
        }

        table.min-w-full thead th {
            background: #e1f1e7;
            color: #14532d;
            font-family: "Space Grotesk", sans-serif;
            font-weight: 700;
            letter-spacing: 0.01em;
            text-transform: uppercase;
            font-size: 12px;
            border-bottom: 1px solid #a7d7b6;
        }

        table.min-w-full th,
        table.min-w-full td {
            padding: var(--space-2);
            border-bottom: 1px solid #e2e8f5;
            vertical-align: middle;
        }

        table.min-w-full tbody tr:nth-child(even) {
            background: #f6fbf8;
        }

        table.min-w-full tbody tr:hover {
            background: #eaf7ee;
        }

        table.min-w-full tbody tr:last-child td {
            border-bottom: 0;
        }

        a,
        button,
        input[type="submit"],
        input[type="button"],
        select,
        textarea {
            min-height: 44px;
        }

        button,
        input[type="submit"],
        input[type="button"] {
            border-radius: var(--radius-sm);
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

        button:not(.app-btn-primary):not(.app-btn-accent),
        input[type="submit"]:not(.app-btn-primary):not(.app-btn-accent),
        input[type="button"]:not(.app-btn-primary):not(.app-btn-accent) {
            background: var(--accent);
            border: 1px solid var(--accent);
            color: #ffffff;
            font-weight: 600;
            padding: 0 var(--space-2);
        }

        button:not(.app-btn-primary):not(.app-btn-accent):hover,
        input[type="submit"]:not(.app-btn-primary):not(.app-btn-accent):hover,
        input[type="button"]:not(.app-btn-primary):not(.app-btn-accent):hover {
            background: var(--accent-strong);
            border-color: var(--accent-strong);
        }

        .app-btn-primary {
            background: var(--accent);
            color: var(--accent-contrast);
            border: 1px solid var(--accent);
            min-height: 44px;
        }

        .app-btn-primary:hover,
        .app-btn-primary:focus-visible {
            background: var(--accent-strong);
            border-color: var(--accent-strong);
        }

        .app-btn-accent {
            background: #166534;
            color: #ffffff;
            border: 1px solid #166534;
            min-height: 44px;
        }

        .app-btn-accent:hover,
        .app-btn-accent:focus-visible {
            background: #14532d;
            border-color: #14532d;
        }

        .app-nav-link:focus-visible,
        .app-btn-primary:focus-visible,
        .app-btn-accent:focus-visible,
        .app-form-field:focus-visible,
        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible,
        a:focus-visible,
        button:focus-visible {
            outline: 3px solid var(--focus-ring);
            outline-offset: 2px;
        }

        .app-shell {
            position: relative;
        }

        .app-shell > * {
            opacity: 0;
            transform: translateY(8px);
        }

        body[data-app-state="ready"] .app-shell > * {
            animation: appReveal 0.46s cubic-bezier(.2, .8, .2, 1) forwards;
        }

        body[data-app-state="ready"] .app-shell > *:nth-child(1) { animation-delay: 0.03s; }
        body[data-app-state="ready"] .app-shell > *:nth-child(2) { animation-delay: 0.09s; }
        body[data-app-state="ready"] .app-shell > *:nth-child(3) { animation-delay: 0.15s; }

        .app-loading-overlay {
            position: fixed;
            inset: 0;
            z-index: 80;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(10, 41, 24, 0.5);
            backdrop-filter: blur(3px);
        }

        body[data-app-state="loading"] .app-loading-overlay {
            display: flex;
        }

        .app-loading-panel {
            background: #0f3b24;
            border: 1px solid rgba(255, 255, 255, 0.24);
            color: #f4fcf7;
            border-radius: var(--radius-md);
            padding: var(--space-3) var(--space-4);
            min-width: 280px;
            text-align: center;
        }

        .app-loading-dot {
            width: 14px;
            height: 14px;
            margin: 0 auto var(--space-2);
            border-radius: 9999px;
            background: #6ee7b7;
            box-shadow: 0 0 0 0 rgba(110, 231, 183, 0.65);
            animation: loadingPulse 1.1s infinite;
        }

        .app-page-message {
            display: none;
            margin: var(--space-2) auto 0;
            max-width: 700px;
            border-radius: var(--radius-md);
            padding: var(--space-2) var(--space-3);
            border: 1px solid;
            font-weight: 600;
        }

        .app-page-message[aria-live] {
            display: block;
        }

        .app-page-message.error {
            background: #fee4e2;
            color: #912018;
            border-color: #fda29b;
        }

        .app-page-message.empty {
            background: #eaf7ee;
            color: #14532d;
            border-color: #a7d7b6;
        }

        [data-empty="true"] .app-empty-state {
            display: flex;
        }

        .app-empty-state {
            display: none;
            align-items: center;
            justify-content: center;
            min-height: 160px;
            text-align: center;
            border: 1px dashed var(--line);
            border-radius: var(--radius-md);
            padding: var(--space-3);
            color: var(--ink-3);
            background: var(--surface-2);
        }

        .app-status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 28px;
            padding: 0 var(--space-2);
            border-radius: 9999px;
            border: 1px solid;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.02em;
            line-height: 1;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .app-status-pending {
            background: #fff5db;
            border-color: #f3cc74;
            color: #8a5300;
        }

        .app-status-approved,
        .app-status-ready {
            background: #dcfce7;
            border-color: #86efac;
            color: #166534;
        }

        .app-status-rejected,
        .app-status-error {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #991b1b;
        }

        .app-status-published {
            background: #d1fae5;
            border-color: #6ee7b7;
            color: #065f46;
        }

        .app-status-awaiting,
        .app-status-review,
        .app-status-submitted,
        .app-status-unassigned {
            background: #e2e8f0;
            border-color: #cbd5e1;
            color: #334155;
        }

        .app-role-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 28px;
            padding: 0 var(--space-2);
            border-radius: 9999px;
            border: 1px solid;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.02em;
            line-height: 1;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .app-role-admin {
            background: #d1fae5;
            border-color: #6ee7b7;
            color: #065f46;
        }

        .app-role-reviewer {
            background: #dcfce7;
            border-color: #86efac;
            color: #166534;
        }

        .app-role-author {
            background: #ede9fe;
            border-color: #c4b5fd;
            color: #5b21b6;
        }

        .app-role-unassigned {
            background: #fff5db;
            border-color: #f3cc74;
            color: #8a5300;
        }

        .app-toast-wrap {
            position: fixed;
            right: 1rem;
            top: 1rem;
            z-index: 9999;
            width: min(24rem, calc(100vw - 2rem));
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .app-toast {
            border-radius: 12px;
            padding: 0.8rem 1rem;
            color: #fff;
            box-shadow: 0 10px 24px rgba(2, 6, 23, 0.25);
            animation: toastIn 0.25s ease;
        }

        .app-toast-success {
            background: var(--success);
        }

        .app-toast-error {
            background: var(--danger);
        }

        .app-toast-info {
            background: var(--accent);
        }

        @@keyframes toastIn {
            from { transform: translateY(-8px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        @@keyframes appReveal {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes loadingPulse {
            0% { box-shadow: 0 0 0 0 rgba(110, 231, 183, 0.65); }
            100% { box-shadow: 0 0 0 16px rgba(110, 231, 183, 0); }
        }
    </style>
</head>

<body class="min-h-screen bg-slate-100 text-slate-900" data-role-state-url="@Url.Action("RoleState", "Home")" data-app-state="loading">
    @{
        var currentController = (ViewContext.RouteData.Values["controller"] ?? string.Empty).ToString();
        var currentAction = (ViewContext.RouteData.Values["action"] ?? string.Empty).ToString();
    }
    <div id="appToastWrap" class="app-toast-wrap" aria-live="polite" aria-atomic="true"></div>
    <div id="appLoadingOverlay" class="app-loading-overlay" aria-hidden="true">
        <div class="app-loading-panel" role="status" aria-live="polite">
            <div class="app-loading-dot"></div>
            <p class="text-sm font-semibold">Loading workspace</p>
            <p class="mt-2 text-xs text-emerald-100">Preparing role and navigation state...</p>
        </div>
    </div>
    <div id="appPageMessage" class="app-page-message" role="status"></div>

    <header class="app-topbar sticky top-0 z-40 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 app-shell">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
                    <i class="ri-layout-grid-line text-xl" aria-hidden="true"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-slate-900">One health Handbook</h1>
                    <p class="text-xs text-slate-500">NHLS Laboratory User Handbook</p>
                </div>
            </div>
            <nav class="flex items-center gap-3 text-sm">
                @if (Request.IsAuthenticated)
                {
                    <a class="app-nav-link inline-flex items-center gap-2 rounded px-3 py-2 text-slate-700 hover:bg-slate-100" href="@Url.Action("Index", "Home")"><i class="ri-home-5-line" aria-hidden="true"></i><span>Home</span></a>
                    <a class="app-nav-link inline-flex items-center gap-2 rounded px-3 py-2 text-slate-700 hover:bg-slate-100" href="@Url.Action("Published", "Content")"><i class="ri-book-open-line" aria-hidden="true"></i><span>Published</span></a>
                }
                else
                {
                    <a class="app-nav-link rounded px-3 py-2 text-slate-700 hover:bg-slate-100" href="@Url.Action("Login", "Account")">Login</a>
                    <a class="app-nav-link rounded px-3 py-2 text-slate-700 hover:bg-slate-100" href="@Url.Action("Register", "Account")">Register</a>
                }
            </nav>
        </div>
    </header>

    @if (Request.IsAuthenticated)
    {
        <div class="app-shell mx-auto flex max-w-7xl flex-col gap-6 px-4 py-8 lg:flex-row">
            <aside class="app-card flex p-4 lg:sticky lg:top-24 lg:w-72 lg:shrink-0 lg:self-start">
                <div class="flex min-h-[70vh] w-full flex-col">
                <h2 class="px-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Dashboard</h2>
                <nav class="mt-2 space-y-1 text-sm">
                          <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Home" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                              href="@Url.Action("Index", "Home")"><i class="ri-home-5-line" aria-hidden="true"></i><span>Home</span></a>
                          <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Content" && currentAction == "Published" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                              href="@Url.Action("Published", "Content")"><i class="ri-book-open-line" aria-hidden="true"></i><span>Published</span></a>
                </nav>

                     <div class="mt-4 hidden" data-role-visible="author">
                          <h2 class="px-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Drafts</h2>
                          <nav class="mt-2 space-y-1 text-sm">
                                <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Content" && currentAction == "Index" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                                    href="@Url.Content("~/Content/Index")"><i class="ri-draft-line" aria-hidden="true"></i><span>My Content</span></a>
                          </nav>
                     </div>

                     <div class="mt-4 hidden" data-role-visible="reviewer">
                          <h2 class="px-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Reviewer Workspace</h2>
                          <nav class="mt-2 space-y-1 text-sm">
                                <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Review" && currentAction == "PendingReviews" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                                    href="@Url.Action("PendingReviews", "Review")"><i class="ri-file-search-line" aria-hidden="true"></i><span>Pending Reviews</span></a>
                                <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Review" && currentAction == "ReviewHistory" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                                    href="@Url.Action("ReviewHistory", "Review")"><i class="ri-checkbox-circle-line" aria-hidden="true"></i><span>Completed Reviews</span></a>
                                <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Review" && currentAction == "Notifications" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                                    href="@Url.Action("Notifications", "Review")"><i class="ri-notification-3-line" aria-hidden="true"></i><span>Notifications</span></a>
                          </nav>
                     </div>

                     <div class="mt-4 hidden" data-role-visible="admin">
                          <h2 class="px-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Admin Workspace</h2>
                          <nav class="mt-2 space-y-1 text-sm">
                                <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Admin" && currentAction == "Users" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                                    href="@Url.Action("Users", "Admin")"><i class="ri-team-line" aria-hidden="true"></i><span>Users</span></a>
                                <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Admin" && currentAction == "Dashboard" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                                    href="@Url.Action("Dashboard", "Admin")"><i class="ri-bar-chart-box-line" aria-hidden="true"></i><span>Admin Dashboard</span></a>
                                <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Admin" && currentAction == "ContentManagement" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                                    href="@Url.Action("ContentManagement", "Admin")"><i class="ri-stack-line" aria-hidden="true"></i><span>Admin Content Queue</span></a>
                                <a class="app-nav-link flex items-center gap-2 rounded-lg px-3 py-2 @(currentController == "Admin" && currentAction == "ReviewerMetrics" ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-100")"
                                    href="@Url.Action("ReviewerMetrics", "Admin")"><i class="ri-line-chart-line" aria-hidden="true"></i><span>Reviewer Metrics</span></a>
                          </nav>
                     </div>

                <h2 class="mt-4 px-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Account</h2>
                <nav class="mt-2 space-y-1 text-sm">
                          <a class="app-nav-link flex items-center gap-3 rounded-xl px-4 py-3 text-base font-semibold @(currentController == "Account" && currentAction == "Profile" ? "bg-slate-900 text-white shadow-sm" : "text-slate-700 hover:bg-slate-100")"
                              href="@Url.Action("Profile", "Account")"><i class="ri-user-settings-line text-lg" aria-hidden="true"></i><span>Profile</span></a>
                </nav>

                <div class="mt-auto pt-6">
                    <div class="rounded-2xl border border-slate-200 bg-white/90 p-3 shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold text-white">
                                @((User.Identity.Name ?? "U").Substring(0, 1).ToUpper())
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-semibold text-slate-900">@User.Identity.Name</p>
                                <div class="mt-1 flex items-center gap-2 text-xs text-slate-500">
                                    <i data-role-icon class="ri-user-line" aria-hidden="true"></i>
                                    <span id="appSidebarRoleBadge" class="app-role-badge app-role-unassigned">
                                        <span data-role-text>Unassigned</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 flex items-center justify-between gap-2">
                            <a class="app-nav-link inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-100" href="@Url.Action("Profile", "Account")">
                                <i class="ri-settings-3-line" aria-hidden="true"></i>
                                <span>Open Profile</span>
                            </a>
                            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100">
                                    <i class="ri-logout-box-r-line" aria-hidden="true"></i>
                                    <span>Logout</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                </div>
            </aside>

            <main class="min-w-0 flex-1">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="app-shell mx-auto max-w-6xl px-4 py-8">
            @RenderBody()
        </main>
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script
    src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        window.appToast = function (type, message) {
            if (!message) {
                return;
            }

            var wrap = document.getElementById("appToastWrap");
            if (!wrap) {
                return;
            }

            var toast = document.createElement("div");
            var normalizedType = type === "error" ? "error" : (type === "success" ? "success" : "info");
            toast.className = "app-toast app-toast-" + normalizedType;
            toast.setAttribute("role", "status");
            toast.textContent = message;
            wrap.appendChild(toast);

            setTimeout(function () {
                toast.remove();
            }, 3600);
        };
    </script>
    <script src="@Url.Content("~/Scripts/app-role-ui.js?v=20260714a")"></script>
    @RenderSection("scripts", required: false)
</body>

</html>
