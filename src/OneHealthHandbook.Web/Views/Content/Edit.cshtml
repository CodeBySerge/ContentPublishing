@model OneHealthHandbook.Web.ViewModels.ContentEditViewModel
@{
    ViewBag.Title = "Edit Content";
}

<section class="mx-auto max-w-2xl rounded-lg bg-white p-6 shadow">
    <h2 class="mb-4 text-2xl font-bold">Edit Content</h2>

    @using (Html.BeginForm("Edit", "Content", FormMethod.Post, new
    {
        id = "contentForm",
        @class = "space-y-4"
    }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ContentId)
        @Html.ValidationSummary(true, "", new { @class = "text-sm text-red-600" })

        <div>
            @Html.LabelFor(m => m.Title, new { @class = "mb-1 block text-sm font-medium" })
            @Html.TextAreaFor(m => m.Title, 2, 40, new { @class = "hidden", id = "titleEditor" })
            <div id="titleEditorContainer" class="rounded-md border border-slate-300 bg-white"></div>
            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-xs text-red-600" })
        </div>

        <div>
            @Html.LabelFor(m => m.Description, new { @class = "mb-1 block text-sm font-medium" })
            @Html.TextAreaFor(m => m.Description, 10, 40, new { @class = "hidden", id = "descriptionEditor" })
            <div id="descriptionEditorContainer" class="rounded-md border border-slate-300 bg-white"></div>
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-xs text-red-600" })
        </div>

        <button type="submit" class="rounded bg-slate-900 px-4 py-2 text-white">Save Changes</button>
    }
</section>

@section scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.min.js"></script>
    <style>
        #titleEditorContainer .ql-editor { min-height: 90px; }
        #descriptionEditorContainer .ql-editor { min-height: 380px; }
    </style>
    <script>
        function makeImageHandler(quillRef) {
            return function () {
                var url = window.prompt("Enter image URL");
                if (url) {
                    var range = quillRef.getSelection(true);
                    quillRef.insertEmbed(range.index, "image", url, "user");
                    quillRef.setSelection(range.index + 1);
                }
            };
        }

        function getQuillHtml(quillInstance) {
            var html = quillInstance.root.innerHTML;
            return html === "<p><br></p>" ? "" : html;
        }

        $(function () {
            var titleQuill = new Quill("#titleEditorContainer", {
                theme: "snow",
                modules: {
                    toolbar: [
                        ["bold", "italic", "underline"],
                        [{ color: [] }, { background: [] }],
                        [{ align: [] }],
                        ["link"],
                        ["clean"]
                    ]
                }
            });
            titleQuill.clipboard.dangerouslyPasteHTML($("#titleEditor").val());

            var descriptionQuill = new Quill("#descriptionEditorContainer", {
                theme: "snow",
                modules: {
                    toolbar: {
                        container: [
                            [{ header: [1, 2, 3, false] }],
                            ["bold", "italic", "underline", "strike"],
                            [{ color: [] }, { background: [] }],
                            [{ align: [] }],
                            [{ list: "ordered" }, { list: "bullet" }],
                            [{ indent: "-1" }, { indent: "+1" }],
                            ["blockquote", "code-block"],
                            ["link", "image"],
                            ["clean"]
                        ],
                        handlers: {}
                    }
                }
            });
            descriptionQuill.getModule("toolbar").addHandler("image", makeImageHandler(descriptionQuill));
            descriptionQuill.clipboard.dangerouslyPasteHTML($("#descriptionEditor").val());

            $("#contentForm").on("submit", function () {
                $("#titleEditor").val(getQuillHtml(titleQuill));
                $("#descriptionEditor").val(getQuillHtml(descriptionQuill));
            });

            $("#contentForm").validate({
                ignore: [],
                rules: {
                    Title: { required: true, maxlength: 250 }
                }
            });

        });
    </script>
}

